
/* Show one image at a time */
.gallery {
    grid-template-columns: 1fr;
    max-width: 600px;
    margin: 0 auto;
}

.gallery-item img {
    width: 100%;
    height: 350px;
    object-fit: cover;
}

.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 25px;
}

.pagination button {
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    background: #6c3ce7;
    color: white;
    cursor: pointer;
}

.pagination button:disabled {
    background: #aaa;
    
